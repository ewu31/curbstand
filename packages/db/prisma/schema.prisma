generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(uuid())
  role             String
  name             String
  email            String                @unique
  passwordHash     String
  organizationType String?
  contact          String?
  producerProfile  ProducerProfile?
  groupBuys        GroupBuy[]            @relation("GroupBuyOwner")
  participants     GroupBuyParticipant[]
  bids             Bid[]
  events           Event[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model ProducerProfile {
  userId             String @id
  farmName           String
  produceTypes       String
  serviceRadiusMiles Int
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProduceCatalog {
  id          String  @id @default(uuid())
  slug        String  @unique
  displayName String
  active      Boolean @default(true)
}

model PickupLocation {
  id          String     @id @default(uuid())
  name        String
  address     String
  region      String     @default("Seattle / Puget Sound")
  timezone    String     @default("America/Los_Angeles")
  active      Boolean    @default(true)
  groupBuys   GroupBuy[]
}

model GroupBuy {
  id                  String                @id @default(uuid())
  produceType         String
  targetLbs           String
  pickupLocationId    String
  pickupWindowStart   DateTime
  pickupWindowEnd     DateTime
  joinDeadline        DateTime
  bidDeadline         DateTime
  status              String                @default("open")
  createdBy           String
  selectedBidId       String?               @unique
  pickupLocation      PickupLocation        @relation(fields: [pickupLocationId], references: [id])
  owner               User                  @relation("GroupBuyOwner", fields: [createdBy], references: [id])
  selectedBid         Bid?                  @relation("SelectedBid", fields: [selectedBidId], references: [id])
  participants        GroupBuyParticipant[]
  bids                Bid[]                 @relation("GroupBuyBids")
  events              Event[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status, pickupWindowStart])
  @@index([produceType, status])
}

model GroupBuyParticipant {
  id             String   @id @default(uuid())
  groupBuyId     String
  userId         String
  requestedLbs   String
  depositAmount  String
  depositStatus  String   @default("pending")
  completionStatus String @default("pending")
  completedAt    DateTime?
  groupBuy       GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([groupBuyId, userId])
}

model Bid {
  id                       String   @id @default(uuid())
  groupBuyId               String
  producerId               String
  pricePerLb               String
  availableLbs             String
  availabilityWindowStart  DateTime
  availabilityWindowEnd    DateTime
  notes                    String?
  status                   String   @default("submitted")
  groupBuy                 GroupBuy @relation("GroupBuyBids", fields: [groupBuyId], references: [id], onDelete: Cascade)
  selectedFor              GroupBuy? @relation("SelectedBid")
  producer                 User     @relation(fields: [producerId], references: [id])
  createdAt                DateTime @default(now())

  @@index([groupBuyId, pricePerLb])
}

model Event {
  id          String   @id @default(uuid())
  groupBuyId  String
  actorUserId String?
  eventType   String
  payload     String
  groupBuy    GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime @default(now())

  @@index([groupBuyId, createdAt])
}

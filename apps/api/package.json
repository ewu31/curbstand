{
  "name": "@curbstand/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "spectrum": "tsx src/spectrum-agent.ts",
    "env:init": "node -e \"const fs=require('fs');fs.existsSync('.env')||fs.copyFileSync('.env.example','.env')\"",
    "db:setup": "npm run env:init && prisma migrate deploy && prisma db seed",
    "db:reset": "npm run env:init && prisma migrate reset --force",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@curbstand/shared": "*",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "spectrum-ts": "^12.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}

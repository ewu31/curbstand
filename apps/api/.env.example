# Relative to apps/api/prisma/
DATABASE_URL="file:./dev.db"
# Any long random string; required when NODE_ENV=production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=8787
# Fixed deposit intent recorded per participation (USD, 2 decimals). Simulated only.
DEPOSIT_AMOUNT_USD="5.00"
# Comma-separated origins allowed for CORS (frontend dev server)
CORS_ORIGINS="http://localhost:5173"
# Per-IP attempts allowed on /auth/signup and /auth/login per window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Max JSON request body size
BODY_LIMIT_BYTES=65536
# Supermarket comparison. Estimates are approximate. Leave the key empty to use a labeled demo sample.
PRICE_COMPARISON_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

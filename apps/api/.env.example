# Relative to apps/api/prisma/
DATABASE_URL="file:./dev.db"
# Any long random string; required when NODE_ENV=production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=8787
# Fixed deposit intent recorded per participation (USD, 2 decimals). Simulated only.
DEPOSIT_AMOUNT_USD="5.00"
# Comma-separated origins allowed for CORS (frontend dev server)
CORS_ORIGINS="http://localhost:4321,http://127.0.0.1:4321,http://localhost:5173"
# Per-IP attempts allowed on /auth/signup and /auth/login per window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Max JSON request body size
BODY_LIMIT_BYTES=65536
# Supermarket comparison. Estimates are approximate. Leave the key empty to use a labeled demo sample.
PRICE_COMPARISON_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Photon 2.0 beta SMS. Leave blank to keep website chat working without sending texts.
# Project API key (pho_sk_...), project id (pho_prj_...), and the SMS agent user id (pho_usr_...).
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_SMS_SENDER_ID=
# Photon Spectrum (stable iMessage). Separate from the Photon 2.0 beta SMS keys above.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
